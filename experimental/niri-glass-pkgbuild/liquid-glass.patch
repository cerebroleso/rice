+// ============================================================================
+// Liquid Glass effect -- faithful port of kwin-effects-glass
+// https://github.com/4v3ngR/kwin-effects-glass
+// ============================================================================
+vec2 safeNormalize(vec2 value) {
+    float scale = max(max(abs(value.x), abs(value.y)), 0.0001);
+    vec2 scaled = value / scale;
+    return scaled / max(length(scaled), 0.0001);
+}
+
+// Rounded-rect SDF -- EXACT copy from kwin
+// cornerRadius: x=bottom-left, y=bottom-right, z=top-left, w=top-right
+float roundedRectangleDist(vec2 p, vec2 b, vec4 cornerRadius)
+{
+    float r = p.x > 0.0
+        ? (p.y > 0.0 ? cornerRadius.y : cornerRadius.w)
+        : (p.y > 0.0 ? cornerRadius.x : cornerRadius.z);
+    vec2 q = abs(p) - b + r;
+    return min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - r;
+}
+
+// Main glass function -- faithful port of ShojiWM's glass shader
+vec4 glass_effect(vec2 uv_tex, vec2 windowUV, vec4 baseColor, vec2 blurSize, vec4 cornerRadius, float refractionStrength)
+{
+    vec2 halfBlurSize = blurSize * 0.5;
+    
+    // Position in pixel coords relative to center
+    vec2 position = windowUV * blurSize - halfBlurSize;
+    position.y = -position.y; // Invert Y for convention
+
+    // Adjust position, blur size, and corner radius according to scale and offset uniforms
+    vec2 offsetPx = lg_geometry_offset * niri_scale;
+    offsetPx.y = -offsetPx.y; // Invert Y for coordinate system
+    
+    vec2 adjustedPosition = position - offsetPx;
+    vec2 adjustedHalfBlurSize = halfBlurSize * lg_geometry_scale;
+    vec4 adjustedCornerRadius = cornerRadius * lg_geometry_scale.x;
+    
+    vec2 adjustedBlurSize = blurSize * lg_geometry_scale;
+    float size = max(min(adjustedBlurSize.x, adjustedBlurSize.y), 1.0);
+    float sdfScale = max(max(adjustedBlurSize.x, adjustedBlurSize.y), 1.0);
+    
+    // Calculate inversed SDF (distance inside the window)
+    float inversedSDF = -roundedRectangleDist(
+        adjustedPosition / sdfScale,
+        adjustedHalfBlurSize / sdfScale,
+        adjustedCornerRadius / sdfScale
+    ) * sdfScale / size;
+    
+    if (inversedSDF < 0.0) {
+        return baseColor;
+    }
+    
+    vec2 normalizedGlassCoord = safeNormalize(adjustedPosition);
+    
+    // ShojiWM Dome Lens Distortion logic
+    // lg_edge_thickness represents the depth of the bezel zone (distortion_depth).
+    // It defaults to 0.15 in LiquidGlass config.
+    float distDepth = max(lg_edge_thickness, 0.0001);
+    float distFromCenter = 1.0 - clamp(inversedSDF / distDepth, 0.0, 1.0);
+    float distortion = 1.0 - sqrt(max(1.0 - pow(distFromCenter, 2.0), 0.0));
+    
+    // Offset in pixel space. refractionStrength is passed as normStrength (0..1)
+    // In ShojiWM: offset = distortion * normalizedGlassCoord * glassSize * 0.5 * distortion_strength;
+    // Which is: distortion * normalizedGlassCoord * halfBlurSize * distortion_strength;
+    vec2 offset = distortion * normalizedGlassCoord * adjustedHalfBlurSize * refractionStrength;
+    
+    // Convert pixel offset to UV offset
+    vec2 uvScale = max(abs(vec2(input_to_geo[0][0], input_to_geo[1][1])), 0.0001);
+    vec2 uvOffset = (vec2(offset.x, -offset.y) / blurSize) / uvScale;
+    vec2 glassUV = clamp(uv_tex - uvOffset, vec2(0.0), vec2(1.0));
+    
+    // Chromatic aberration (fringing)
+    // lg_fringing represents the chromatic shift in pixels.
+    // In ShojiWM: shift = normalizedGlassCoord * edge * chromatic_shift_px;
+    float edge = smoothstep(0.0, 0.02, inversedSDF);
+    vec2 shift = normalizedGlassCoord * edge * lg_fringing;
+    vec2 uvShift = (vec2(shift.x, -shift.y) / blurSize) / uvScale;
+    
+    vec3 glassColor;
+    if (lg_fringing > 0.001) {
+        glassColor.r = texture2D(tex, clamp(glassUV - uvShift, vec2(0.0), vec2(1.0))).r;
+        glassColor.g = texture2D(tex, glassUV).g;
+        glassColor.b = texture2D(tex, clamp(glassUV + uvShift, vec2(0.0), vec2(1.0))).b;
+    } else {
+        glassColor = texture2D(tex, glassUV).rgb;
+    }
+    
+    // Multiplicative tinting (map glass_tint to lg_brightness)
+    glassColor *= clamp(lg_brightness, 0.0, 2.0);
