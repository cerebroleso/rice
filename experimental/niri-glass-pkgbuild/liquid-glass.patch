+    // Controlled dynamically by 'edge-lighting' in your config.
+    float borderWidth = 1.5 / size;
+    float borderAlpha = smoothstep(borderWidth, 0.0, inversedSDF) * lg_edge_lighting;
+    glassColor = mix(glassColor, vec3(1.0), borderAlpha);
+    
+    return vec4(glassColor, baseColor.a);
