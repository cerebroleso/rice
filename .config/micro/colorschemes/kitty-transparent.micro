color-link default ",default"
color-link comment "bold blue"
color-link identifier "cyan"
color-link constant "magenta"
color-link statement "yellow"
color-link symbol "red"
color-link preproc "red"
color-link type "green"
color-link special "red"
color-link underlined "underline blue"
color-link error "bold red"
color-link todo "bold yellow"
color-link statusline "black,white"
color-link tabbar "black,white"
color-link indent-char "black"
color-link line-number "yellow,default"
color-link current-line-number "bold yellow,default"
color-link gutter-error "red"
color-link gutter-warning "yellow"
color-link cursor-line ",default"
color-link color-column "red"
