layout {

    focus-ring {
        active-color "#d0c5b2"
        inactive-color "#141312"
        urgent-color "#ffb4ab"
    }

    border {
        active-color "#d0c5b2"
        inactive-color "#141312"
        urgent-color "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color "#d0c5b2"
        inactive-color "#433c2e"
        urgent-color "#ffb4ab"
    }

    insert-hint {
        color "#d0c5b280"
    }
}

recent-windows {
    highlight {
        active-color "#d0c5b2"
        urgent-color "#ffb4ab"
    }
}
