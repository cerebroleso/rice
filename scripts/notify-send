#!/usr/bin/env bash
# Intercept notify-send and default to NixOS Flake logo when no icon is specified

# Path to NixOS Flake SVG icon
ICON_PATH="/run/current-system/sw/share/icons/hicolor/scalable/apps/nix-snowflake.svg"
if [ ! -f "$ICON_PATH" ]; then
  ICON_PATH="nix-snowflake"
fi

has_icon=false
for arg in "$@"; do
  if [[ "$arg" == "-i" ]] || [[ "$arg" == "--icon"* ]] || [[ "$arg" == -i=* ]]; then
    has_icon=true
    break
  fi
done

if [ "$has_icon" = false ]; then
  exec /run/current-system/sw/bin/notify-send -i "$ICON_PATH" "$@"
else
  exec /run/current-system/sw/bin/notify-send "$@"
fi
